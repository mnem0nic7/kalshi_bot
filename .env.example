CRYPTO_HISTORICAL_PAGINATION_STOP_AT_CUTOFF=false
CRYPTO_HISTORY_CANDLE_CONCURRENCY=1
CRYPTO_SPOT_CURRENT_AUTO_ENABLED=true
CRYPTO_SPOT_CURRENT_INTERVAL_SECONDS=15
CRYPTO_EMPIRICAL_BUCKET_GATE_ENABLED=true
CRYPTO_EMPIRICAL_BUCKET_GATE_ASSETS=live
CRYPTO_EMPIRICAL_BUCKET_MIN_SAMPLES=20
CRYPTO_EMPIRICAL_BUCKET_MIN_NET_PNL_DOLLARS=0.0
CRYPTO_EMPIRICAL_BUCKET_MIN_WIN_RATE=0.55
CRYPTO_EMPIRICAL_LATE_OVERRIDE_ENABLED=true
CRYPTO_EMPIRICAL_LATE_OVERRIDE_MAX_SECONDS_TO_CLOSE=180
CRYPTO_EMPIRICAL_LATE_OVERRIDE_REASONS=empirical_bucket_missing,empirical_bucket_low_win_rate
CRYPTO_EMPIRICAL_LATE_OVERRIDE_MAX_COUNT_FP=1.0
CRYPTO_EMPIRICAL_LATE_OVERRIDE_NEGATIVE_PNL_ENABLED=false
CRYPTO_POSITION_ADD_ONS_ENABLED=true
CRYPTO_POSITION_ADD_ON_ASSETS=BNB,BTC,DOGE,ETH,HYPE,SOL,XRP
CRYPTO_POSITION_ADD_ON_MAX_POSITION_COUNT_FP=200.0
CRYPTO_POSITION_ADD_ON_MAX_TICKET_COUNT_FP=500.0
CRYPTO_AUTONOMY_ENABLED=false
CRYPTO_PRODUCTION_AUTONOMY_ENABLED=false
CRYPTO_TRADING_ENABLED=false
COINBASE_CDP_API_KEY_FILE=cdp_api_key.json
COINBASE_CDP_KEY_NAME=
COINBASE_CDP_PRIVATE_KEY=
COINBASE_ADVANCED_TRADE_AUTHENTICATED_ENABLED=true
CRYPTO_SPOT_PROXY_FALLBACK_ENABLED=false
MONOTONICITY_ARB_ENABLED=false
MONOTONICITY_ARB_SHADOW_ONLY=true
CRYPTO_MODEL_NIGHTLY_AUTO_ENABLED=false
CRYPTO_MODEL_NIGHTLY_TIMEZONE=America/Los_Angeles
CRYPTO_MODEL_NIGHTLY_HOUR_LOCAL=3
CRYPTO_MODEL_NIGHTLY_MIN_NEW_STRICT_ROWS=60
CRYPTO_MODEL_NIGHTLY_MAX_AGE_HOURS=336
CRYPTO_MODEL_NIGHTLY_ASSETS=BTC,ETH,SOL,XRP,BNB,DOGE,HYPE
# Tree-model training device. XGBoost may use the GPU (device=cuda); it falls
# back to CPU (logged) if CUDA is unavailable or OOMs, and auto-uses CPU below
# CRYPTO_GPU_MIN_ROWS where GPU overhead isn't worth it (measured crossover
# ~20k rows on a GTX 1660-class card). LightGBM stays cpu: its CPU learner beats
# its OpenCL GPU path at every size we train (set device=gpu only to experiment).
# Docker Compose GPU request for app/daemon services; set to "all" on GPU hosts.
KALSHI_BOT_GPUS=all
CRYPTO_XGBOOST_DEVICE=cuda
CRYPTO_GPU_MIN_ROWS=20000
CRYPTO_LIGHTGBM_DEVICE=cpu
CRYPTO_LIGHTGBM_N_JOBS=-1
CRYPTO_TRAIN_LOOKBACK_DAYS=60
DAEMON_RECONCILE_INTERVAL_SECONDS=60
DAEMON_HEARTBEAT_INTERVAL_SECONDS=60
DAEMON_START_WITH_RECONCILE=true
DAEMON_STARTUP_GRACE_SECONDS=30
DAEMON_STARTUP_JITTER_SECONDS=45
STRATEGY_REGRESSION_DAILY_RUN_SECONDS=86400
STRATEGY_CODEX_NIGHTLY_ENABLED=false
STRATEGY_CODEX_NIGHTLY_TIMEZONE=America/Los_Angeles
STRATEGY_CODEX_NIGHTLY_HOUR_LOCAL=1
STRATEGY_AUTO_EVOLVE_ENABLED=false
STRATEGY_AUTO_EVOLVE_WINDOW_DAYS=180
STRATEGY_AUTO_EVOLVE_ACCEPT_SUGGESTIONS=true
STRATEGY_AUTO_EVOLVE_ACTIVATE_SUGGESTIONS=false
STRATEGY_AUTO_EVOLVE_ASSIGN_ELIGIBLE=false
SELF_IMPROVE_WINDOW_DAYS=14
SELF_IMPROVE_HOLDOUT_RATIO=0.2
SELF_IMPROVE_MIN_IMPROVEMENT=0.02
SELF_IMPROVE_MAX_CRITICAL_REGRESSION=0.01
SELF_IMPROVE_CANARY_MIN_ROOMS=25
SELF_IMPROVE_CANARY_MIN_SECONDS=7200
SELF_IMPROVE_LIVE_MONITOR_SECONDS=86400
SELF_IMPROVE_RESEARCH_GATE_FAILURE_THRESHOLD=0.6
SELF_IMPROVE_BLOCKED_ORDER_THRESHOLD=0.8
