(shared_proxy) {
	reverse_proxy {args[0]} {
		header_up Host {host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		flush_interval -1
	}
}

home.kb-trade.trade {
	tls internal
	import shared_proxy web_production:8000
}

http://localhost, http://127.0.0.1 {
	import shared_proxy web_production:8000
}
